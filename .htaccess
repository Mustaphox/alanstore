# ==============================================================================
# ALAN STORE - Performance & Security Configuration (.htaccess)
# ==============================================================================

# Prevent directory listing
Options -Indexes

# Protect sensitive files (config.php, SQL dumps, hidden files, logs)
<FilesMatch "^(.*\.sql|config\.php|\.env|\.git|\.log)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Force UTF-8 encoding
AddDefaultCharset UTF-8

# ------------------------------------------------------------------------------
# 1. GZIP / DEFLATE COMPRESSION (Drastically reduces bandwidth & page load time)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
    # Compress HTML, CSS, JavaScript, Text, XML and fonts
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
</IfModule>

# ------------------------------------------------------------------------------
# 2. BROWSER CACHING (Instant load on repeat visits)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # Images & Media
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType video/webm "access plus 1 year"

    # Webfonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"

    # CSS & JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"

    # HTML & Dynamic
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ------------------------------------------------------------------------------
# 3. HTTP HEADERS (Keep-Alive, Cache-Control, Security)
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    # 1 year cache for static assets with immutable tag
    <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|woff|woff2|ttf|otf|mp4|webm)$">
        Header set Cache-Control "max-age=31536000, public, no-transform"
    </FilesMatch>

    # 1 month cache for CSS and JS
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>

    # Keep-Alive connection
    Header set Connection keep-alive

    # Prevent MIME type sniffing
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# ------------------------------------------------------------------------------
# 4. URL REWRITE & CLEAN URLS
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Hide .php extension
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*)$ $1.php [L]
</IfModule>
